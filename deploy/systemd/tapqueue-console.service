# Optional: show the TapQueue server's live log on the machine's screen (tty1) instead of a login
# prompt. Log in on another console with Alt+F2.
#
#   sudo cp tapqueue-console.service /etc/systemd/system/
#   sudo systemctl mask getty@tty1 && sudo systemctl enable --now tapqueue-console
#
# Undo: sudo systemctl disable --now tapqueue-console && sudo systemctl unmask getty@tty1 && sudo systemctl start getty@tty1
[Unit]
Description=TapQueue server log on the local screen (tty1)
After=tapqueue-server.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=exec
ExecStart=/bin/sh -c 'setterm --blank 0 --powerdown 0; clear; echo "TapQueue server on $(hostname) - $(hostname -I | cut -d" " -f1):8631 - Alt+F2 to log in"; echo; exec journalctl -u tapqueue-server -f -n 50 -o short --no-hostname'
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
