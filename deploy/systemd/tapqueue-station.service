[Unit]
Description=TapQueue release station (badge reader)
Documentation=https://github.com/jthy10/TapQueue
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=tapqueue-station
Group=tapqueue-station
# The badge reader: /dev/input for keyboard readers, /dev/hidraw for pcProx (see deploy/udev).
SupplementaryGroups=input
# Builds published on the server are installed into the state directory (/opt is read-only here);
# start from there when there is one. install-station.sh removes it, so a manual install wins.
StateDirectory=tapqueue-station
ExecStart=/bin/sh -c 'b=/var/lib/tapqueue-station/tapqueue-station; [ -x "$$b" ] || b=/opt/tapqueue/tapqueue-station; exec "$$b" --config /etc/tapqueue/station.toml'
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=char-hidraw rw

[Install]
WantedBy=multi-user.target
