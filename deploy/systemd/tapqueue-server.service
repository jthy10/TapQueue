[Unit]
Description=TapQueue print server
Documentation=https://github.com/jthy10/TapQueue
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=tapqueue
Group=tapqueue
ExecStart=/opt/tapqueue/tapqueue-server --config /etc/tapqueue/server.toml
Restart=on-failure
RestartSec=5
# Exit code 75 is a restart asked for from the admin console: start again, and don't call it a failure.
RestartForceExitStatus=75
SuccessExitStatus=75

# Held print jobs live here; keep them private to the service.
StateDirectory=tapqueue
StateDirectoryMode=0700

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
