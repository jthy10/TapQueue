<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Server, station and admin CLI; released together with tags server-vX.Y.Z. -->
    <Version>0.6.0</Version>
    <!-- Windows client; released on its own with tags client-vX.Y.Z. -->
    <TapQueueClientVersion>0.6.0</TapQueueClientVersion>
    <Authors>TapQueue contributors</Authors>
    <Product>TapQueue</Product>
    <Copyright>Copyright (c) TapQueue contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <!-- Lets the Windows client build on Linux (CI, dev boxes). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
